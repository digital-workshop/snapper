<Window x:Class="Snapper.DragTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapper Ziehen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="0"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">
    <!-- Reiter, der unten aus dem Editor-Fenster herausschaut -->
    <Border x:Name="Tab" Background="#FFFF2D5F" CornerRadius="0,0,20,20" Height="38" Padding="22,0,22,2"
            Cursor="Hand" ToolTip="Festhalten und in eine App, Mail oder einen Chat ziehen"
            PreviewMouseLeftButtonDown="Tab_MouseDown" PreviewMouseMove="Tab_MouseMove"
            PreviewMouseLeftButtonUp="Tab_MouseUp">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Foreground="White" FontSize="14"
                       Margin="0,1,9,0" VerticalAlignment="Center" />
            <TextBlock Text="Ziehen" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <TextBlock x:Name="SizeText" Foreground="White" Opacity="0.8" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
