<Window x:Class="Snapper.DragTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snapper"
        Title="{local:T drag.title}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="0"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">
    <!--
        Lasche, die unten aus dem Editor-Fenster herausschaut.
        Oben links und rechts schwingt sie mit einer Rundung nach außen in die Fensterkante.
        Maße: Breite 252, Höhe 42. Rundungen oben 20, Ecken unten 17.
    -->
    <Grid Width="252" Height="42" Cursor="Hand"
          ToolTip="{local:T drag.tip}"
          PreviewMouseLeftButtonDown="Tab_MouseDown" PreviewMouseMove="Tab_MouseMove"
          PreviewMouseLeftButtonUp="Tab_MouseUp">
        <Path Fill="#FFFF2D5F"
              Data="M0,0 H252 A20,20 0 0 0 232,20 V25 A17,17 0 0 1 215,42 H37 A17,17 0 0 1 20,25 V20 A20,20 0 0 0 0,0 Z" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,3,0,0" IsHitTestVisible="False">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Foreground="White" FontSize="14"
                       Margin="0,1,9,0" VerticalAlignment="Center" />
            <TextBlock Text="{local:T drag}" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <TextBlock x:Name="SizeText" Foreground="White" Opacity="0.8" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
