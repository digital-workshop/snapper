<Window x:Class="Snapper.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapper Auswahl"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" WindowStartupLocation="Manual"
        Left="0" Top="0" Width="400" Height="300" AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid x:Name="Root" ClipToBounds="True">
        <Image x:Name="ShotImage" Stretch="Fill" />
        <Path x:Name="Dim" Fill="#A60A0C14" IsHitTestVisible="False" />

        <Border x:Name="SelBorder" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="White" BorderThickness="1.5" CornerRadius="3">
            <Border.Effect>
                <DropShadowEffect Color="#FF2D5F" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <Border x:Name="SizeBadge" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F2FFFFFF" CornerRadius="11" Padding="11,5">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <TextBlock x:Name="SizeText" FontSize="12.5" FontWeight="SemiBold" Foreground="#1B1D26" />
        </Border>

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0"
                IsHitTestVisible="False" Background="#F2FFFFFF" CornerRadius="16" Padding="18,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.28" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#FF2D5F" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Bereich aufziehen" FontWeight="SemiBold" FontSize="14" Foreground="#1B1D26" />
                <TextBlock Text="   Esc = Abbrechen" FontSize="13" Foreground="#6B7080" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
