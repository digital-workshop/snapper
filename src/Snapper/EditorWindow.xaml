<Window x:Class="Snapper.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snapper"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Snapper" Width="1100" Height="720" MinWidth="900" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="#FFEEF1F7" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- weiche Farbflecken hinter dem Glas -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-260,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4DFF7AA0" Offset="0" />
                        <GradientStop Color="#00FF7AA0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D6FA2FF" Offset="0" />
                        <GradientStop Color="#006FA2FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titelleiste -->
            <Grid Grid.Row="0" Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Snapper" FontSize="16" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center" />
                    <Border Background="#0F1B1D26" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="SizeChip" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
                    </Border>
                    <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="{local:T undo}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Undo_Click" />
                    <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="{local:T redo}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Redo_Click" Margin="2,0,16,0" />
                    <Button Style="{StaticResource PillButton}" ToolTip="{local:T new.tip}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="New_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{local:T new}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateBtn" Style="{StaticResource PillButton}" Visibility="Collapsed" Margin="10,0,0,0"
                            Foreground="{StaticResource Accent}" ToolTip="{local:T update.tip}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="UpdateText" Text="{local:T update.default}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{local:T minimize}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click" />
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="{local:T maximize}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{local:T close}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Inhalt -->
            <Grid Grid.Row="1" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Werkzeugleiste links -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="9,9">
                    <StackPanel>
                        <RadioButton x:Name="ToolArrow" GroupName="tool" Style="{StaticResource ToolButton}" IsChecked="True"
                                     ToolTip="{local:T tool.arrow.tip}" Click="Tool_Click" Tag="Arrow">
                            <Path Style="{StaticResource ToolIcon}" Data="M5,19 L19,5 M19,5 L10,6 M19,5 L18,14" />
                        </RadioButton>
                        <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" ToolTip="{local:T tool.text.tip}" Click="Tool_Click" Tag="Text">
                            <Path Style="{StaticResource ToolIcon}" Data="M5,8 V5 H19 V8 M12,5 V19 M9,19 H15" />
                        </RadioButton>
                        <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" ToolTip="{local:T tool.rect.tip}" Click="Tool_Click" Tag="Rect">
                            <Path Style="{StaticResource ToolIcon}" Data="M5,8 Q5,5 8,5 H16 Q19,5 19,8 V16 Q19,19 16,19 H8 Q5,19 5,16 Z" />
                        </RadioButton>
                        <RadioButton GroupName="tool" Style="{StaticResource ToolButton}" ToolTip="{local:T tool.pixelate.tip}" Click="Tool_Click" Tag="Pixelate">
                            <Path Style="{StaticResource ToolIcon}" StrokeThickness="0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M4,4 h4 v4 h-4z M12,4 h4 v4 h-4z M8,8 h4 v4 h-4z M16,8 h4 v4 h-4z M4,12 h4 v4 h-4z M12,12 h4 v4 h-4z M8,16 h4 v4 h-4z M16,16 h4 v4 h-4z" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Mitte: Bild -->
                <Border x:Name="CenterCard" Grid.Column="2" Style="{StaticResource Card}" Background="#8CFFFFFF" CornerRadius="28">
                    <Grid x:Name="Host" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                          MouseLeftButtonDown="Host_MouseLeftButtonDown" MouseMove="Host_MouseMove"
                          MouseLeftButtonUp="Host_MouseLeftButtonUp" MouseWheel="Host_MouseWheel"
                          MouseDown="Host_MouseDown" MouseUp="Host_MouseUp" SizeChanged="Host_SizeChanged">
                        <!-- Canvas, damit die Zoom-Ebene nie auf die Fenstergröße beschnitten wird -->
                        <Canvas>
                            <Grid x:Name="ZoomLayer" RenderTransformOrigin="0,0">
                                <Grid x:Name="ContentGrid" ClipToBounds="True" Background="White">
                                    <Image x:Name="BaseImage" Stretch="None" />
                                    <Canvas x:Name="Anno" />
                                </Grid>
                            </Grid>
                        </Canvas>

                        <!-- Meldung -->
                        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                                Background="#F2FFFFFF" CornerRadius="18" Padding="16,10" Opacity="0" IsHitTestVisible="False"
                                MouseLeftButtonDown="Toast_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="#1B1D26" BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="20" Height="20" Fill="#FF22C55E" Margin="0,0,10,0" />
                                <TextBlock x:Name="ToastText" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Zoom unten -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="#F2FFFFFF" CornerRadius="18" Padding="6,4">
                            <Border.Effect>
                                <DropShadowEffect Color="#1B1D26" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.14" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="30" Content="&#xE71F;" FontSize="13" Click="ZoomOut_Click" ToolTip="{local:T zoom.out}" />
                                <TextBlock x:Name="ZoomLabel" Width="56" TextAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                                <Button Style="{StaticResource IconButton}" Width="32" Height="30" Content="&#xE8A3;" FontSize="13" Click="ZoomIn_Click" ToolTip="{local:T zoom.in}" />
                                <Border Width="1" Background="{StaticResource Hairline}" Margin="6,6" />
                                <Button Style="{StaticResource IconButton}" Width="auto" Height="30" Padding="10,0" FontFamily="{StaticResource UiFont}"
                                        FontWeight="SemiBold" FontSize="12.5" Content="{local:T fit}" Click="Fit_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Rechts: Einstellungen -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,20,20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="ToolTitle" Text="{local:T tool.arrow}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="HintText" FontSize="12.5" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,4,0,18" />

                            <StackPanel x:Name="StyleSection" Margin="0,0,0,10">
                                <TextBlock Text="{local:T label.style}" Style="{StaticResource SectionLabel}" />
                                <WrapPanel x:Name="StylePanel" />
                            </StackPanel>

                            <StackPanel x:Name="ColorSection" Margin="0,0,0,16">
                                <TextBlock Text="{local:T label.color}" Style="{StaticResource SectionLabel}" />
                                <UniformGrid x:Name="ColorPanel" Columns="6" />
                            </StackPanel>

                            <StackPanel x:Name="SizeSection">
                                <TextBlock x:Name="SizeLabel" Text="{local:T label.thickness}" Style="{StaticResource SectionLabel}" />
                                <Border Background="#0F1B1D26" CornerRadius="14" Padding="3">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="Size0" GroupName="size" Style="{StaticResource SegButton}" Content="{local:T size.thin}" Click="Size_Click" Tag="0" />
                                        <RadioButton x:Name="Size1" GroupName="size" Style="{StaticResource SegButton}" Content="{local:T size.medium}" Click="Size_Click" Tag="1" IsChecked="True" />
                                        <RadioButton x:Name="Size2" GroupName="size" Style="{StaticResource SegButton}" Content="{local:T size.thick}" Click="Size_Click" Tag="2" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource PrimaryButton}" Click="Copy_Click" ToolTip="{local:T copy.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,1,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T copy}" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T copy.keys}" FontWeight="Normal" FontSize="11.5" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="Save_Click" ToolTip="{local:T save.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,1,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T save}" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T save.keys}" FontWeight="Normal" FontSize="11.5" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
